APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=https://limitra-ecommerce.vercel.app
JWT_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=redis
ANALYTICS_DASHBOARD_CACHE_TTL=300
CATALOG_CACHE_TTL=300
AUTH_SESSION_CACHE_TTL=300
AUTH_SESSION_NEGATIVE_CACHE_TTL=30
AUTH_SESSION_TOUCH_INTERVAL=300

MAINTENANCE_AUTH_SESSION_RETENTION_DAYS=30
MAINTENANCE_CHECKOUT_QUOTE_RETENTION_HOURS=24
MAINTENANCE_ANALYTICS_RETENTION_DAYS=90
MAINTENANCE_PRUNE_BATCH_SIZE=1000
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

HORIZON_PATH=horizon
HORIZON_PAYMENTS_MAX_PROCESSES=3
HORIZON_NOTIFICATIONS_MAX_PROCESSES=2
HORIZON_AI_MAX_PROCESSES=2
HORIZON_ANALYTICS_MAX_PROCESSES=2
HORIZON_MAINTENANCE_MAX_PROCESSES=1
HORIZON_DEFAULT_MAX_PROCESSES=2
HORIZON_DASHBOARD_USER=
HORIZON_DASHBOARD_PASSWORD=

AI_DRIVER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT=60
OPENROUTER_CONNECT_TIMEOUT=5
OPENROUTER_SITE_URL="${APP_URL}"
OPENROUTER_APP_NAME="${APP_NAME}"

MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail_preview
MAIL_PREVIEW_ENABLED=false
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

SUPPLIER_SERVICE_URL=
SUPPLIER_SERVICE_SECRET=
SUPPLIER_SERVICE_TIMEOUT=20
SUPPLIER_SERVICE_RETRIES=2

# Docker Compose host overrides
APP_PORT=8000
DOCKER_DB_DATABASE=limitra
DOCKER_DB_USERNAME=limitra
DOCKER_DB_PASSWORD=limitra_db_password
DOCKER_REDIS_PASSWORD=limitra_redis_password
