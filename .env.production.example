LIMITRA_API_IMAGE=ghcr.io/biqxx/limitra-api:main

APP_NAME=Limitra
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
ENABLE_SWAGGER_DOCS=true
APP_URL=https://api.limitra.com.ng
FRONTEND_URL=https://limitra.com.ng
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

JWT_SECRET=CHANGE_ME

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=limitra_api
DB_USERNAME=limitra_api
DB_PASSWORD=CHANGE_ME

CACHE_STORE=redis
CACHE_PREFIX=limitra_api_cache_
SESSION_DRIVER=redis
SESSION_CONNECTION=default
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_SAME_AS_PLATFORM_REDIS
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=limitra_api_

HORIZON_NAME=LimitraAPI
HORIZON_PREFIX=limitra_api_horizon:
HORIZON_PAYMENTS_MAX_PROCESSES=1
HORIZON_NOTIFICATIONS_MAX_PROCESSES=1
HORIZON_AI_MAX_PROCESSES=1
HORIZON_ANALYTICS_MAX_PROCESSES=1
HORIZON_MAINTENANCE_MAX_PROCESSES=1
HORIZON_DEFAULT_MAX_PROCESSES=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Limitra

AI_DRIVER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://limitra.com.ng
OPENROUTER_APP_NAME=Limitra

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
